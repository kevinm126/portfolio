# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in only what you want to turn on.
#  EVERY feature works without these — it just runs on realistic demo data.
#  Add a key, restart `npm run dev`, and that feature goes live. See SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL for OG tags, canonical links, sitemap, and robots.
# Optional on Vercel (the production domain is auto-detected); set it when you
# have a custom domain, e.g. https://kevinmarin.dev
NEXT_PUBLIC_SITE_URL=

# AI "Ask my résumé" chatbot + terminal `ask` command.
# Provider chain: Claude (best quality, pay-as-you-go pennies) → Gemini
# (FREE, no card) → canned answers (no key at all). Set either key.
#
# Claude: https://console.anthropic.com → API Keys (needs purchased credits)
ANTHROPIC_API_KEY=
# Gemini, the free option: https://aistudio.google.com → Get API key.
# Card-free; the free tier covers portfolio traffic many times over.
GEMINI_API_KEY=
# Only to pin a specific model (default: gemini-flash-latest, a rolling alias)
# GEMINI_MODEL=

# Live GitHub stats. Also set `githubUsername` in src/content/content.ts.
# A token is optional (only raises the rate limit). Create a *classic* token
# with no scopes (public data) at https://github.com/settings/tokens
GITHUB_TOKEN=

# Spotify "now playing". See SETUP.md for the one-time OAuth dance.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# WakaTime coding-time widget. Key: https://wakatime.com/settings/account
WAKATIME_API_KEY=

# Contact form → email, via Resend (https://resend.com). Without it, messages
# are logged server-side and the form still shows success.
# ALSO powers "Bother Kev" (/bother): when the little guy snaps he emails you
# for real. Without a key those emails are only logged and the game says so.
# Rate limits are hard-coded in src/app/api/bother/route.ts (per-IP + daily).
RESEND_API_KEY=

# Where Bother Kev's emails land. Set this to keep the game's mail out of your
# main inbox. Falls back to `profile.email` in src/content/content.ts if unset.
# (The contact form is separate and always uses profile.email.)
#
# FREE SETUP: Resend's shared sender only delivers to the address that OWNS the
# Resend account — so sign up at resend.com with this exact address and the free
# tier (100/day) reaches it with no domain and no card.
BOTHER_EMAIL_TO=

# Only needed to mail an inbox OTHER than the Resend account's own, which
# requires verifying a domain at https://resend.com/domains.
# RESEND_FROM="Kev <kev@yourdomain.com>"
RESEND_FROM=

# Community chess: the secret that lets you (Kevin) play Black's reply.
# Visit /chess?admin=THIS_VALUE once to unlock your moves in this browser.
# Defaults to "kevin-dev" if unset — change it before deploying.
CHESS_ADMIN_KEY=

# Durable guestbook + view counter + community chess (optional). Without these
# they use an in-memory store that resets on restart. Upstash has a free tier.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
