# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in only what you want to turn on.
#  EVERY feature works without these — it just runs on realistic demo data.
#  Add a key, restart `npm run dev`, and that feature goes live. See SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# AI "Ask my résumé" chatbot + terminal `ask` command.
# Get one at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# Live GitHub stats. Also set `githubUsername` in src/content/content.ts.
# A token is optional (only raises the rate limit). Create a *classic* token
# with no scopes (public data) at https://github.com/settings/tokens
GITHUB_TOKEN=

# Spotify "now playing". See SETUP.md for the one-time OAuth dance.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# WakaTime coding-time widget. Key: https://wakatime.com/settings/account
WAKATIME_API_KEY=

# Contact form → email, via Resend (https://resend.com). Without it, messages
# are logged server-side and the form still shows success.
RESEND_API_KEY=

# Community chess: the secret that lets you (Kevin) play Black's reply.
# Visit /chess?admin=THIS_VALUE once to unlock your moves in this browser.
# Defaults to "kevin-dev" if unset — change it before deploying.
CHESS_ADMIN_KEY=

# Durable guestbook + view counter + community chess (optional). Without these
# they use an in-memory store that resets on restart. Upstash has a free tier.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
